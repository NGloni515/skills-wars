# Address players' games connect to (your server's public IP or domain).
PUBLIC_HOST=127.0.0.1
PORT=3000

# Godot match server executable and the engine arguments placed before "--".
# Local dev with the editor binary:
MATCH_SERVER_COMMAND=godot
MATCH_SERVER_ARGS=--headless --path ../game
# Exported Linux server build (Docker):
# MATCH_SERVER_COMMAND=/app/server/skills-wars-server.x86_64
# MATCH_SERVER_ARGS=--headless

# UDP ports handed to match servers, one per room.
MATCH_PORT_MIN=7800
MATCH_PORT_MAX=7819

# Shared secret match servers use to send heartbeats (16+ characters).
MATCH_SECRET=change-me-to-a-long-random-string

# Optional tuning (milliseconds).
# MATCH_START_TIMEOUT_MS=15000
# MATCH_HEARTBEAT_TIMEOUT_MS=20000
# EMPTY_ROOM_TTL_MS=90000
